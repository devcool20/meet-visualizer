{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@stash/card-spec": ["../packages/card-spec/src/index.ts"],
      "@stash/card-core": ["../packages/card-core/src/index.ts"],
      "@stash/card-react": ["../packages/card-react/src/index.ts"],
      "@stash/card-canvas": ["../packages/card-canvas/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
