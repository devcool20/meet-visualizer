# -------------------------------------------------------------
# Stash Live — Frontend Environment Variables (for Vercel & Local)
# -------------------------------------------------------------

# Mock vs real data. UNSET = real engine in production builds.
#
# This one bit us: `.env` is gitignored, so VITE_STASH_MOCK=0 never reached
# Vercel, and `isMockMode()` used to fall back to mock whenever
# VITE_SUPABASE_URL was missing. A deploy then served fixtures instead of live
# cards. Production no longer implies mock, but set this explicitly anyway so
# the intent is visible in the Vercel project settings:
#
#   Vercel   -> VITE_STASH_MOCK=0
#   local    -> VITE_STASH_MOCK=0   (real engine, as below)
#   demo/offline -> VITE_STASH_MOCK=1
VITE_STASH_MOCK=0

# Backend API URL (Render Deployed Cloud Engine)
VITE_STASH_API_URL=https://stash-live-engine.onrender.com

# Backend WebSocket URL (Render Deployed Cloud WebSocket)
VITE_ENGINE_WS_URL=wss://stash-live-engine.onrender.com

# Product Origin (Frontend Domain on Vercel)
VITE_STASH_PRODUCT_ORIGIN=https://stashlive.vercel.app

# AI Provider Configuration
VITE_STASH_AI_PROVIDER=bedrock

# -------------------------------------------------------------
# Stash Live meeting platform (engine side — see render.yaml too)
# -------------------------------------------------------------
#
# These live on the ENGINE, not here: the browser discovers the signalling
# endpoint from VITE_STASH_API_URL, so there is no second source of truth for
# "where is the engine". Listed here because they are the first thing to reach
# for when a call will not connect.
#
# STASH_MEETING_ENABLED=1            # 0 turns /ws/meeting + the REST routes off
# STASH_MEETING_STUN_URL=            # comma-separated; defaults to Google STUN
# STASH_MEETING_TURN_URL=            # REQUIRED behind symmetric NAT / firewalls
# STASH_MEETING_TURN_USERNAME=
# STASH_MEETING_TURN_CREDENTIAL=
# STASH_MEETING_MESH_LIMIT=6         # max remote peers per participant (1-12)
