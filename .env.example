# Copy to .env.local for local development. Every value has a safe fallback,
# so the dashboard runs fully in mock mode with none of these set (see
# src/lib/api.ts, src/lib/auth.ts).

# Set to "1" (or leave VITE_SUPABASE_URL unset) to force mock auth + a mock
# in-memory API client. This is what makes the whole dashboard demoable
# without a live backend or Supabase project.
VITE_STASH_MOCK=1

# Real Supabase project (Google OAuth configured as a provider there).
# Leaving these unset also triggers mock mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Stash Live engine's REST API. Defaults to same-origin in
# production and to http://localhost:5000 in dev.
VITE_STASH_API_URL=

# Product origin — the dashboard's own origin, used by the extension's
# externally_connectable. Defaults to https://meet-visualizer.vercel.app.
VITE_STASH_PRODUCT_ORIGIN=

# Extension ID for pairing. Two tiers: this env var (build-time) or
# localStorage['stash_extension_id'] (runtime). Defaults to the dev ID.
VITE_STASH_EXTENSION_ID=

# Extension distribution mode: 'unpacked' (default, while review is pending)
# or 'webstore' (once the Chrome Web Store listing is live).
VITE_STASH_EXT_SOURCE=

# Optional URL to download a pre-built extension zip. When unset, the
# install screen references building from the repo.
VITE_STASH_EXT_ZIP_URL=
